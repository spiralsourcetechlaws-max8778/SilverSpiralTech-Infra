{
    "files.exclude": {
        "**/.git": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/data": true,
        "**/operator.cfg": true,
        "**/.env": true
    },
    "editor.formatOnSave": true,
    "editor.rulers": [80, 100],
